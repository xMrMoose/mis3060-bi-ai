// HW6 Part B: Power BI values for reports/powerbi_values.csv
// One row per measure x slice. Values are converted to text so the grid shows them unrounded,
// without the measures' display formats ($, %, 2 decimals). Blank = no value (e.g., 2020 has no prior year).
DEFINE
    VAR GrandTotal =
        SELECTCOLUMNS (
            {
                ( "Total Fees", [Total Fees] & "" ),
                ( "Net Flows", [Net Flows] & "" ),
                ( "AUM (naive SUM)", [AUM (naive SUM)] & "" ),
                ( "Ending AUM", [Ending AUM] & "" ),
                ( "Ending Clients", [Ending Clients] & "" ),
                ( "Avg AUM per Client", [Avg AUM per Client] & "" ),
                ( "Ending AUM LY", [Ending AUM LY] & "" ),
                ( "AUM YoY %", [AUM YoY %] & "" ),
                ( "Ending AUM PM", [Ending AUM PM] & "" ),
                ( "AUM MoM %", [AUM MoM %] & "" ),
                ( "Avg Monthly AUM", [Avg Monthly AUM] & "" ),
                ( "Fee Yield (bps)", [Fee Yield (bps)] & "" ),
                ( "Organic Growth Rate", [Organic Growth Rate] & "" ),
                ( "AUM-Weighted Alpha", [AUM-Weighted Alpha] & "" ),
                ( "Alpha Signal", [Alpha Signal] & "" ),
                ( "Top 10 Client Share", [Top 10 Client Share] & "" )
            },
            "measure", [Value1],
            "slice", "total",
            "value", [Value2]
        )
    VAR ByYear =
        SELECTCOLUMNS (
            GENERATE (
                VALUES ( dim_date[year] ),
                {
                    ( "AUM (naive SUM)", [AUM (naive SUM)] & "" ),
                    ( "Ending AUM", [Ending AUM] & "" ),
                    ( "Ending AUM LY", [Ending AUM LY] & "" ),
                    ( "AUM YoY %", [AUM YoY %] & "" ),
                    ( "Avg Monthly AUM", [Avg Monthly AUM] & "" ),
                    ( "Fee Yield (bps)", [Fee Yield (bps)] & "" ),
                    ( "Organic Growth Rate", [Organic Growth Rate] & "" ),
                    ( "AUM-Weighted Alpha", [AUM-Weighted Alpha] & "" ),
                    ( "Alpha Signal", [Alpha Signal] & "" )
                }
            ),
            "measure", [Value1],
            "slice", "year=" & dim_date[year],
            "value", [Value2]
        )
    VAR ByTier2024 =
        SELECTCOLUMNS (
            CALCULATETABLE (
                GENERATE (
                    VALUES ( dim_client[client_tier] ),
                    {
                        ( "Ending AUM", [Ending AUM] & "" ),
                        ( "Avg AUM per Client", [Avg AUM per Client] & "" ),
                        ( "Ending AUM LY", [Ending AUM LY] & "" ),
                        ( "AUM YoY %", [AUM YoY %] & "" ),
                        ( "Fee Yield (bps)", [Fee Yield (bps)] & "" ),
                        ( "Organic Growth Rate", [Organic Growth Rate] & "" ),
                        ( "AUM-Weighted Alpha", [AUM-Weighted Alpha] & "" ),
                        ( "Alpha Signal", [Alpha Signal] & "" ),
                        ( "Top 10 Client Share", [Top 10 Client Share] & "" )
                    }
                ),
                dim_date[year] = 2024
            ),
            "measure", [Value1],
            "slice", "year=2024|client_tier=" & dim_client[client_tier],
            "value", [Value2]
        )
    VAR Dec2024 =
        SELECTCOLUMNS (
            CALCULATETABLE (
                {
                    ( "Ending AUM", [Ending AUM] & "" ),
                    ( "Ending AUM PM", [Ending AUM PM] & "" ),
                    ( "AUM MoM %", [AUM MoM %] & "" )
                },
                dim_date[year] = 2024,
                dim_date[month] = 12
            ),
            "measure", [Value1],
            "slice", "month=2024-12",
            "value", [Value2]
        )
EVALUATE
UNION ( GrandTotal, ByYear, ByTier2024, Dec2024 )
ORDER BY [slice], [measure]
