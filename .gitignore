# ── Python ──────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
build/
dist/

# Virtual environments
venv/
.venv/
env/
ENV/

# ── Jupyter ─────────────────────────────────────────────
.ipynb_checkpoints/
*.nbconvert.ipynb

# ── Environment / secrets ──────────────────────────────
.env
.env.*
*.pem
*.key
secrets.*

# ── Data (often large / sensitive — track intentionally) ─
*.csv
# Exception: homework deliverables (hw01/, hw02/, ... hw08/) are CSVs that must be tracked
!hw*/*.csv
*.xlsx
*.parquet
*.h5
*.pkl
*.db
*.sqlite3

# ── OS / editor cruft ───────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
*.swp

# ── Logs / misc ─────────────────────────────────────────
*.log
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints
